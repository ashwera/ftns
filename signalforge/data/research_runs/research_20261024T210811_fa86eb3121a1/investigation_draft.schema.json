{
  "type": "object",
  "properties": {
    "status": {
      "enum": [
        "supported",
        "inconclusive",
        "rejected"
      ]
    },
    "headline": {
      "type": "string"
    },
    "summary": {
      "type": "string"
    },
    "why_it_matters": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "claims": {
      "type": "array",
      "minItems": 1,
      "maxItems": 8,
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string"
          },
          "text": {
            "type": "string"
          },
          "assessment": {
            "enum": [
              "supported",
              "contradicted",
              "unresolved"
            ]
          },
          "key": {
            "type": "boolean"
          },
          "citations": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "evidence_id": {
                  "type": "string"
                },
                "quote": {
                  "type": "string"
                }
              },
              "required": [
                "evidence_id",
                "quote"
              ],
              "additionalProperties": false
            }
          }
        },
        "required": [
          "id",
          "text",
          "assessment",
          "key",
          "citations"
        ],
        "additionalProperties": false
      }
    },
    "timeline": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "date": {
            "type": "string"
          },
          "event": {
            "type": "string"
          },
          "evidence_ids": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        },
        "required": [
          "date",
          "event",
          "evidence_ids"
        ],
        "additionalProperties": false
      }
    },
    "calculations": {
      "type": "array",
      "maxItems": 6,
      "items": {
        "type": "object",
        "properties": {
          "label": {
            "type": "string"
          },
          "operation": {
            "enum": [
              "difference",
              "ratio_percent",
              "sum",
              "days"
            ]
          },
          "inputs": {
            "type": "array",
            "minItems": 2,
            "maxItems": 8,
            "items": {
              "type": "object",
              "properties": {
                "value": {
                  "type": "string"
                },
                "evidence_id": {
                  "type": "string"
                },
                "quote": {
                  "type": "string"
                }
              },
              "required": [
                "value",
                "evidence_id",
                "quote"
              ],
              "additionalProperties": false
            }
          },
          "unit": {
            "type": "string"
          },
          "basis": {
            "type": "string"
          }
        },
        "required": [
          "label",
          "operation",
          "inputs",
          "unit",
          "basis"
        ],
        "additionalProperties": false
      }
    },
    "counterargument": {
      "type": "object",
      "properties": {
        "text": {
          "type": "string"
        },
        "evidence_ids": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      },
      "required": [
        "text",
        "evidence_ids"
      ],
      "additionalProperties": false
    },
    "falsification": {
      "type": "string"
    },
    "limitations": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "follow_up_queries": {
      "type": "array",
      "maxItems": 2,
      "items": {
        "type": "string"
      }
    }
  },
  "required": [
    "status",
    "headline",
    "summary",
    "why_it_matters",
    "claims",
    "timeline",
    "calculations",
    "counterargument",
    "falsification",
    "limitations",
    "follow_up_queries"
  ],
  "additionalProperties": false
}
