{
  "$schema":"https://json-schema.org/draft/2020-12/schema",
  "title":"SignalForge canonical evidence record",
  "type":"object",
  "required":["evidence_id","company_name","verified_identifier","company_identity_status","source_organization","document_title","document_type","source_url","source_path","source_locator","source_identifier_status","publication_date","event_date","retrieval_date","excerpt_or_fact","metric_name","metric_value","unit","currency","reporting_period","evidence_category","related_claim","claim_key","source_relationship","claim_verification_status","information_type","parsing_status","extraction_warnings","page_number","table_identifier"],
  "properties":{
    "evidence_id":{"type":"string","pattern":"^ev_[a-f0-9]{24}$"},"company_name":{"type":["string","null"]},"verified_identifier":{"type":["string","null"]},"company_identity_status":{"enum":["verified","unresolved"]},
    "source_organization":{"type":["string","null"]},"document_title":{"type":"string"},"document_type":{"type":"string"},"source_url":{"type":["string","null"],"format":"uri"},"source_path":{"type":["string","null"]},"source_locator":{"type":"string"},"source_identifier_status":{"enum":["provided_url","repository_path_only","missing"]},
    "publication_date":{"type":["string","null"]},"event_date":{"type":["string","null"]},"retrieval_date":{"type":"string"},"excerpt_or_fact":{"type":"string"},"metric_name":{"type":["string","null"]},"metric_value":{"type":["number","string","null"]},"unit":{"type":["string","null"]},"currency":{"type":["string","null"]},"reporting_period":{"type":["string","null"]},"evidence_category":{"type":"string"},"related_claim":{"type":["string","null"]},"claim_key":{"type":["string","null"]},"source_relationship":{"enum":["original_disclosure","republication","independent_source","unknown"]},"claim_verification_status":{"enum":["directly_reported","independently_corroborated","calculated","inferred","unverified"]},"information_type":{"enum":["reported_fact","derived_calculation","inference","unverified_hypothesis"]},
    "parsing_status":{"enum":["parsed","failed","ocr_required","empty"]},"extraction_warnings":{"type":"array","items":{"type":"string"}},"page_number":{"type":["integer","null"],"minimum":1},"table_identifier":{"type":["string","null"]},
    "review_status":{"type":["string","null"],"enum":["pending_review","approved","rejected",null]},"reviewed_by":{"type":["string","null"]},"reviewed_at":{"type":["string","null"]},"review_note":{"type":["string","null"]}
  },"additionalProperties":false
}
