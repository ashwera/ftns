# Local inference (recommended for demos; no cloud quota). Requires `ollama serve`.
# With qwen3:8b already installed: ollama create signalforge-qwen8b -f signalforge/Modelfile.qwen3-8b
# 4B alternative: ollama create signalforge-qwen -f signalforge/Modelfile.qwen3-4b
SIGNALFORGE_PROVIDER=ollama
SIGNALFORGE_MODEL=signalforge-qwen
SIGNALFORGE_BASE_URL=http://127.0.0.1:11434/v1
# Optional: only used for Gemini URL hints / grounded search, never for inference under ollama.
SIGNALFORGE_API_KEY=

# Cloud alternative:
# SIGNALFORGE_PROVIDER=gemini
# SIGNALFORGE_MODEL=gemini-3.5-flash
# SIGNALFORGE_API_KEY=<your key>
# CSV defaults to the quote export at the repository root. Override with an
# absolute SIGNALFORGE_CSV_PATH in the launching shell if it was moved.
