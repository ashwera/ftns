# Hosted demo configuration; see ARSHIA_DEMO_HANDOVER.md for observed quotas.
SIGNALFORGE_PROVIDER=groq
SIGNALFORGE_MODEL=openai/gpt-oss-120b
SIGNALFORGE_BASE_URL=https://api.groq.com/openai/v1
# Separate Gemini credential, used only by a configured Gemini route.
SIGNALFORGE_API_KEY=

# Cloud alternative:
# SIGNALFORGE_PROVIDER=gemini
# SIGNALFORGE_MODEL=gemini-3.1-flash-lite
# SIGNALFORGE_API_KEY=<your key>
SIGNALFORGE_CSV_PATH=../Quote-Equity-NTPC-EQ-15-04-2026-15-10-2026.csv

# Groq backup: dedicated credential, never the Gemini key.
GROQ_API_KEY=
# To select Groq as primary:
# SIGNALFORGE_PROVIDER=groq
# SIGNALFORGE_MODEL=openai/gpt-oss-20b
# SIGNALFORGE_BASE_URL=https://api.groq.com/openai/v1

# Ordered fallback providers (blank disables failover). Every cloud provider needs its own key.
SIGNALFORGE_FALLBACK_PROVIDERS=gemini
SIGNALFORGE_GROQ_MODEL=openai/gpt-oss-120b
SIGNALFORGE_GEMINI_MODEL=gemini-3.1-flash-lite
SIGNALFORGE_OLLAMA_MODEL=signalforge-qwen
# Per transport request, zero SDK retries; maximum four distinct providers.
SIGNALFORGE_REQUEST_TIMEOUT=60
# Local alternative (requires an installed model and running server):
# SIGNALFORGE_PROVIDER=ollama
# SIGNALFORGE_MODEL=signalforge-qwen
# SIGNALFORGE_BASE_URL=http://127.0.0.1:11434/v1
