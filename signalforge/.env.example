# xAI inference. Actual keys belong only in an ignored local .env or environment.
SIGNALFORGE_PROVIDER=xai
SIGNALFORGE_MODEL=grok-4.7
SIGNALFORGE_BASE_URL=https://api.x.ai/v1
XAI_API_KEY=

# Independent Gemini search / URL hints; preserve an existing credential.
SIGNALFORGE_API_KEY=
# SIGNALFORGE_SEARCH_MODEL=gemini-3.8-flash

# Explicit optional local alternative:
# SIGNALFORGE_PROVIDER=ollama
# SIGNALFORGE_MODEL=signalforge-qwen
# SIGNALFORGE_BASE_URL=http://127.0.0.1:11434/v1
# Requires ollama serve and the existing configured model.

# CSV defaults to the quote export at repository root. Override with an absolute
# SIGNALFORGE_CSV_PATH in the launching shell if moved. No company join is implied.
